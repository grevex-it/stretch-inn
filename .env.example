# Conexión de la app: rol sin privilegios (sin SUPERUSER ni BYPASSRLS). Ver docs/decisiones/0002.
DATABASE_URL=postgres://app_usuario:clave@localhost:5432/stretch_inn
# Conexión para migraciones: dueño del esquema. Nunca la usa la app.
DATABASE_URL_MIGRACIONES=postgres://postgres:clave@localhost:5432/stretch_inn
PUERTO=3000
# Origen del panel: único aceptado en los pedidos que cambian datos. Ver docs/decisiones/0017.
ORIGEN_PANEL=http://localhost:5173
# En Railway: 1. Confía en un solo proxy y toma la IP que agrega a X-Forwarded-For (límite de intentos).
# DETRAS_DE_PROXY=1
# Solo para `pnpm logs`: rol logs_lector, que lee únicamente el esquema logs. Ver docs/decisiones/0016.
# LOGS_DATABASE_URL=postgres://logs_lector:clave@localhost:5432/stretch_inn
